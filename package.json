{
  "name": "@lordsarcastic/coss-ui-angular",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve docs",
    "build": "ng build coss-ui-angular && ng build docs",
    "build:lib": "ng build coss-ui-angular",
    "build:docs": "ng build docs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test coss-ui-angular --watch=false --browsers=ChromeHeadless",
    "lint": "biome check .",
    "format": "biome format . --write",
    "ci": "npm run lint && npm run test && npm run build",
    "serve:ssr:docs": "node dist/docs/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.26",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.26",
    "@angular/cli": "^20.3.10",
    "@angular/compiler-cli": "^20.3.0",
    "@biomejs/biome": "^2.4.15",
    "@tailwindcss/forms": "^0.5.11",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "autoprefixer": "^10.5.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  }
}
